{
  "name": "@svgdotjs/svg.topoly.js",
  "version": "1.0.3",
  "description": "An extension for svg.js to convert shapes to polygons",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "main": "dist/svg.topoly.js",
  "module": "dist/svg.topoly.mjs",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/svg.topoly.d.mts",
        "default": "./dist/svg.topoly.mjs"
      },
      "import": {
        "types": "./dist/svg.topoly.d.mts",
        "default": "./dist/svg.topoly.mjs"
      },
      "require": {
        "types": "./dist/svg.topoly.d.ts",
        "default": "./dist/svg.topoly.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/svg.topoly.js",
  "jsdelivr": "dist/svg.topoly.js",
  "files": [
    "/dist",
    "!/dist/*.zip"
  ],
  "keywords": [
    "svg.js"
  ],
  "bugs": "https://github.com/svgdotjs/svg.topoly.js/issues",
  "license": "MIT",
  "typings": "./dist/svg.topoly.d.ts",
  "author": {
    "name": "Wout Fierens"
  },
  "contributors": [
    {
      "name": "Wout Fierens"
    },
    {
      "name": "Ulrich-Matthias Schäfer"
    }
  ],
  "homepage": "https://github.com/svgdotjs/svg.topoly.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svgdotjs/svg.topoly.js.git"
  },
  "scripts": {
    "build": "pnpm fix && tsc && vite build",
    "fix": "oxfmt --write . && oxlint -D correctness --fix .",
    "lint": "oxfmt --check . && oxlint -D correctness .",
    "prepublishOnly": "rm -rf ./dist && pnpm build && pnpm zip",
    "zip": "zip -j dist/svg.topoly.js.zip -- LICENSE README.md dist/svg.topoly.js",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.1.0"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "^3.2.8",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "svgdom": "^0.1.28",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
